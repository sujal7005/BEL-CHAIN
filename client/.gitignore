# ---- OS junk ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- Editor / IDE ----
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ---- Logs ----
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Env / secrets (never commit) ----
.env
.env.*
!.env.example

# ---- Node ----
node_modules/
.pnp
.pnp.js
npm-cache/

# ---- Build output ----
dist/
build/
out/
*.tsbuildinfo

# ---- Test / coverage ----
coverage/
.nyc_output/

# ---- Vite cache ----
.vite/
client/.vite/

# ---- Local storage (encrypted files fallback) ----
server/storage/

# ---- IPFS local repo (if you ever run one in-project) ----
.ipfs/
ipfs-data/

# ---- Temp ----
tmp/
temp/
*.tmp