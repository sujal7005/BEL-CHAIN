NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/belchain
JWT_SECRET=change-me-please-a-long-random-string
JWT_EXPIRES_IN=12h
# IPFS
IPFS_API_URL=http://127.0.0.1:5001
USE_IPFS=true
# Local fallback storage
STORAGE_DIR=./storage
# Master key for wrapping org keys (AES-256). MUST be 64 hex chars.
MASTER_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CLIENT_ORIGIN=http://localhost:5173